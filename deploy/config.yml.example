# Everything at the root of this file is the default configuration, applied to every
# list. 'use:' pulls in named blocks defined further down (mail-config, list-defaults,
# database below) — a named block only takes effect where it's referenced via 'use:'
# (here, or in a list-provider's own 'use:'), it is otherwise inert.
language: de
# Public hostname this instance is reachable under (behind your reverse proxy) —
# used to build login/dashboard/manage-page/unsubscribe links. Required for a real
# deployment: gethostname() (the container's own, usually meaningless hostname) is
# only a last-resort fallback, and the worker logs a warning at startup if this is
# left unset. See CLAUDE.md "Docker Setup".
hostname: $APP_HOST

# Optional: shown everywhere the app names itself — page titles, header, login mail
# subject, delivery-failure notices. Defaults to "Listig". See CLAUDE.md "App name
# (app-name)".
# app-name: My Mailing Lists

# Optional: log in via an OIDC provider (e.g. Keycloak, Authelia, authentik) instead
# of / in addition to the magic-link email form. Only takes effect once all three
# keys below are set — uncomment to enable. See CLAUDE.md "OIDC login (oidc-*)".
# oidc-provider-url: https://sso.yourdomain.org
# oidc-client-id: listig
# oidc-client-secret: $OIDC_CLIENT_SECRET

use:
  - mail-config
  - list-defaults
  - database

# Named block — referenced via 'use:' above
mail-config:
  imap-host: $IMAP_HOST
  imap-port: 993
  imap-secure: ssl
  smtp-host: $SMTP_HOST
  smtp-port: 587
  smtp-secure: tls
  mail-user: "{list-mail}"
  mail-password: $MAIL_PASSWORD

# Named block — referenced via 'use:' above
list-defaults:
  reply-to: sender
  allow-leave: direct
  list-label: "[{display-name}]"
  footer: "<p>Diese Mail wurde über die Liste {display-name} verschickt. <a href=\"{list-url}\">Zur Liste</a></p>"

# Named block — referenced via 'use:' above
database:
  db-host: $DB_HOST
  db-port: $DB_PORT
  db-name: $DB_NAME
  db-user: $DB_USER
  db-password: $DB_PASS

# A map keyed by provider name (not a list) — the name identifies the provider in
# logs/errors, and doubles as its 'type' if the provider sets none of its own (here,
# 'main' has an explicit type: inline; without it, 'main' would need to be spelled
# 'inline' to work — see CLAUDE.md "list-providers").
list-providers:
  inline:
    lists:
      example:
        list-mail: example@yourdomain.org
        display-name: "Example List"
        members:
          - alice@example.org
          - firstname: Bob
            lastname: Example
            mail: bob@example.org
        owners:
          - firstname: Carol
            lastname: Example
            mail: carol@example.org

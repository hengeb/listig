# database connection, referenced via 'db-*' keys in config.yml
DB_HOST=db
DB_PORT=3306
DB_NAME=database
DB_USER=user
DB_PASS=secret

# mail server, referenced via in config.yml
IMAP_HOST=imap.example.org
SMTP_HOST=smtp.example.org
MAIL_PASSWORD=secret

# public hostname this instance is reachable under, referenced via 'hostname' in
# config.yml — see CLAUDE.md "Docker Setup"
APP_HOST=lists.example.org

# optional: OIDC login — see CLAUDE.md "OIDC login (oidc-*)". Only takes effect
# once oidc-provider-url/oidc-client-id/oidc-client-secret are all set in config.yml.
#OIDC_CLIENT_SECRET=secret

# 32 random bytes, base64-encoded. Used for AES-256-CBC and HMAC-SHA256.
APP_SECRET=base64encodedkey32bytes

{layout '../../templates/layout.latte'}

{block title}{$translator->trans('list.manage.title_prefix')}: {$list->displayName|escapeHtml} – {$appName}{/block}

{block head}
<script>
const csrf = document.cookie.split(';').map(c => c.trim()).find(c => c.startsWith('PHPSESSID='))?.split('=')[1] ?? '';
async function apiPost(url) {
    const r = await fetch(url, { method: 'POST', headers: { 'X-CSRF-Token': csrf } });
    if (!r.ok) { alert({$translator->trans('list.manage.js_error_prefix')} + (await r.json()).error); return; }
    location.reload();
}
async function apiDelete(url) {
    const r = await fetch(url, { method: 'DELETE', headers: { 'X-CSRF-Token': csrf } });
    if (!r.ok) { alert({$translator->trans('list.manage.js_error_generic')}); return; }
    location.reload();
}
</script>
{/block}

{block content}
<h1>{$list->displayName|escapeHtml} <small style="font-size:.6em;color:#777">{$list->mail|escapeHtml}</small></h1>

<p n:if="$list->archive->value !== 'off' && $list->archive->value !== 'hidden'">
    <a href="/{$list->name}/archive" class="btn btn-secondary">{$translator->trans('archive.index.heading')}</a>
</p>

<!-- Info -->
<div class="card">
    <h2>{$translator->trans('list.manage.overview')}</h2>
    <table>
        <tr n:if="$list->description !== null && $list->description !== ''">
            <th>{$translator->trans('list.manage.description')}</th><td>{$list->description|escapeHtml}</td>
        </tr>
        <tr><th>{$translator->trans('list.manage.members')}</th><td>{$memberCount}</td></tr>
        <tr><th>{$translator->trans('list.manage.owners')}</th><td>
            {foreach $list->getOwners() as $owner}
                {($owner->attributes['firstname'] ?? '')|escapeHtml} {($owner->attributes['lastname'] ?? '')|escapeHtml}{sep}, {/sep}
            {/foreach}
        </td></tr>
        <tr><th>{$translator->trans('list.manage.reply_to')}</th><td>{$list->replyTo->value|escapeHtml}</td></tr>
        <tr><th>{$translator->trans('list.manage.access')}</th><td>{$list->postAccess->value|escapeHtml}</td></tr>
        <tr><th>{$translator->trans('list.manage.moderation')}</th><td>{$list->moderation->value|escapeHtml}</td></tr>
    </table>
</div>

<!-- Moderation queue -->
<div class="card" n:if="count($moderationItems) > 0">
    <h2>{$translator->trans('list.manage.moderation_queue')} ({count($moderationItems)})</h2>
    <table>
        <thead><tr><th>{$translator->trans('list.manage.received')}</th><th>{$translator->trans('list.manage.actions')}</th></tr></thead>
        <tbody>
        <tr n:foreach="$moderationItems as $item">
            <td>{$item['created_at']|escapeHtml}</td>
            <td>
                <button class="btn btn-success" onclick="apiPost('/_/api/moderation/{$item['id']}/accept')">{$translator->trans('list.manage.accept')}</button>
                <button class="btn btn-danger" onclick="apiPost('/_/api/moderation/{$item['id']}/reject')">{$translator->trans('list.manage.reject')}</button>
            </td>
        </tr>
        </tbody>
    </table>
</div>

<!-- Queue status -->
<div class="card">
    <h2>{$translator->trans('list.manage.queue_status')}</h2>
    <p>
        {$translator->trans('list.manage.sent')}: <strong>{$queueStatus['sent']}</strong> /
        {$translator->trans('list.manage.failed')}: <strong style="color:#c0392b">{$queueStatus['failed']}</strong> /
        {$translator->trans('list.manage.total')}: <strong>{$queueStatus['total']}</strong>
    </p>
</div>

<!-- Bounce stats -->
<div class="card">
    <h2>{$translator->trans('list.manage.bounces')}</h2>
    <p>
        {$translator->trans('list.manage.last_7_days')}: <strong>{$bounceStats['last7']}</strong> &nbsp;|&nbsp;
        {$translator->trans('list.manage.last_30_days')}: <strong>{$bounceStats['last30']}</strong>
    </p>
    <table n:if="count($bounceStats['recent']) > 0">
        <thead><tr><th>{$translator->trans('list.manage.sender')}</th><th>{$translator->trans('list.manage.subject')}</th><th>{$translator->trans('list.manage.timestamp')}</th></tr></thead>
        <tbody>
        <tr n:foreach="$bounceStats['recent'] as $bounce">
            <td>{$bounce['sender']|escapeHtml}</td>
            <td>{$bounce['subject']|escapeHtml}</td>
            <td>{$bounce['bounced_at']|escapeHtml}</td>
        </tr>
        </tbody>
    </table>
</div>
{/block}

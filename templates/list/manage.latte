{layout '../../templates/layout.latte'}

{block title}{$translator->trans('list.manage.title_prefix')}: {$list->displayName} – {$appName}{/block}

{block head}
{* list-manage.js needs script.js's getCsrfToken() to already be defined — see
   the ordering comment on templates/layout.latte's own <script src> tag. *}
<script src="/assets/dom-morph.js" defer></script>
<script src="/assets/list-manage.js" defer></script>
{/block}

{block page_title}{$list->displayName} <small class="list-mail-subtitle"><a n:tag-if="$nav->canPost" href="mailto:{$list->mail}">{$list->mail}</a></small>{/block}
{block page_description}{$list->description}{/block}
{block page_actions}{include '../list-actions.latte', nav: $nav, translator: $translator}{/block}

{block content}
{* Translated strings for list-manage.js — a static file can't itself contain
   server-rendered translations, so they're threaded through via data
   attributes instead. See docs/architecture/i18n.md "Internationalization". *}
<div id="list-manage-i18n" hidden
    data-error-prefix="{$translator->trans('list.manage.js_error_prefix')}"
    data-error-generic="{$translator->trans('list.manage.js_error_generic')}"
></div>
<!-- Info -->
<div class="card">
    <h2>{$translator->trans('list.manage.overview')}</h2>
    <table>
        <tr><th>{$translator->trans('list.manage.members')}</th><td>{$memberCount}</td></tr>
        <tr><th>{$translator->trans('list.manage.owners')}</th><td>
            {foreach $list->getOwners() as $owner}
                {$list->resolveMemberDisplayName($owner)}{sep}, {/sep}
            {/foreach}
        </td></tr>
        <tr><th>{$translator->trans('list.manage.join_policy')}</th><td>{$list->joinPolicy->value}</td></tr>
        <tr><th>{$translator->trans('list.manage.visibility')}</th><td>{$list->visibility->value}</td></tr>
        <tr><th>{$translator->trans('list.manage.reply_to')}</th><td>{$list->replyTo->value}</td></tr>
        <tr><th>{$translator->trans('list.manage.access_members')}</th><td>{$list->postAccessMembers->value}</td></tr>
        <tr><th>{$translator->trans('list.manage.access_public')}</th><td>{$list->postAccessPublic->value}</td></tr>
        <tr><th>{$translator->trans('list.manage.archive')}</th><td>
            {$list->archive->value}{if $list->archive->value !== 'off'} ({$list->archiveMaxAge ?? $translator->trans('list.manage.archive_unlimited')}){/if}
        </td></tr>
    </table>
</div>

<!-- Moderation queue -->
<div class="card" n:if="count($moderationItems) > 0">
    <h2>{$translator->trans('list.manage.moderation_queue')} ({count($moderationItems)})</h2>
    <table>
        <thead><tr>
            <th>{$translator->trans('list.manage.subject')}</th>
            <th>{$translator->trans('list.manage.sender')}</th>
            <th>{$translator->trans('list.manage.received')}</th>
            <th>{$translator->trans('list.manage.actions')}</th>
        </tr></thead>
        <tbody>
        {* Clicking anywhere in the row opens the same read-only preview as the
           archive viewer (ModerationController::show(), reusing archive/show.latte
           — the mail is still on IMAP, not yet archived). The Subject cell also
           carries a real <a> so the row is reachable without JS / via keyboard /
           open-in-new-tab — the row-level onclick is a convenience on top of that,
           not a replacement for it. Accept/Reject stop propagation so clicking a
           button doesn't also navigate away first. *}
        <tr n:foreach="$moderationItems as $item" class="clickable-row" onclick="location.href={sprintf('/%s/moderation/%s', $list->name, $item['id'])}">
            <td><a href="/{$list->name}/moderation/{$item['id']}">{($item['subject'] ?? '')}</a></td>
            <td>{$item['sender_display']}</td>
            {* mail_date is only null for an item queued before this column existed
               (the migration doesn't backfill) — falls back to created_at, same as
               before, until that item is accepted/rejected/reminded. *}
            <td n:attr="data-utc: $item['mail_date'] !== null ? str_replace(' ', 'T', $item['mail_date']) . 'Z' : null">{($item['mail_date'] ?? $item['created_at'])}</td>
            <td>
                <button class="btn btn-success" onclick="event.stopPropagation(); apiPost('/_/api/moderation/{$item['id']}/accept')">{$translator->trans('list.manage.accept')}</button>
                <button class="btn btn-danger" onclick="event.stopPropagation(); apiPost('/_/api/moderation/{$item['id']}/reject')">{$translator->trans('list.manage.reject')}</button>
            </td>
        </tr>
        </tbody>
    </table>
</div>

{* Delivery queue + bounces refresh themselves (list-manage.js): fast while mails are pending,
   slowly otherwise. The same fragment is what GET /_/api/live/{listname} returns. *}
<div id="manage-live-container" data-url="/_/api/live/{$list->name}">
    {include 'manage-live.latte', queueStatus: $queueStatus, bounceStats: $bounceStats, list: $list, translator: $translator}
</div>

{* Only ever populated by the `restrict` automatic bounce action — see
   docs/architecture/bounces.md "Automatic bounce actions". Rendered only when non-empty, so a
   list that never triggered it shows nothing extra. *}
<div class="card" n:if="count($suppressedMembers) > 0">
    <h2>{$translator->trans('list.manage.suppressed_members')}</h2>
    <table>
        <thead><tr><th>{$translator->trans('list.manage.address')}</th><th>{$translator->trans('list.manage.reason')}</th><th>{$translator->trans('list.manage.timestamp')}</th></tr></thead>
        <tbody>
        <tr n:foreach="$suppressedMembers as $suppressed">
            <td>{$suppressed['envelope_to']}</td>
            <td>{$suppressed['reason']}</td>
            <td>{$suppressed['created_at']}</td>
        </tr>
        </tbody>
    </table>
</div>
{/block}

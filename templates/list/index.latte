{layout '../../templates/layout.latte'}

{block title}{$list->displayName} – {$appName ?? 'Listig'}{/block}

{* Heading, description and buttons are the page header (layout.latte), so they sit in the
   same place on every list page and custom.latte can place them. *}
{block page_title}{$list->displayName} <small class="list-mail-subtitle"><a n:tag-if="$nav->canPost" href="mailto:{$list->mail}">{$list->mail}</a></small>{/block}
{block page_description}{$list->description}{/block}
{block page_actions}{include '../list-actions.latte', nav: $nav, translator: $translator}{/block}

{block content}
<div class="card">
    <p n:if="count($list->getOwners()) > 0">
        <strong>{$translator->trans('list.manage.owners')}:</strong>
        {foreach $list->getOwners() as $owner}
            {$list->resolveMemberDisplayName($owner)}{sep}, {/sep}
        {/foreach}
    </p>
    <p>
        <strong>{$translator->trans('list.info.join_policy')}:</strong>
        {$translator->trans('list.join_policy.' . $list->joinPolicy->value)}
    </p>
</div>
{/block}

{layout '../../templates/layout.latte'}

{block title}{$list->displayName} – {$appName ?? 'Listig'}{/block}

{block content}
{* Same structure as list/manage.latte — heading, then the action buttons — so the buttons
   stay in the same place when switching between a list's pages. *}
<h1>{$list->displayName} <small class="list-mail-subtitle"><a n:tag-if="$nav->canPost" href="mailto:{$list->mail}">{$list->mail}</a></small></h1>

{include '../list-actions.latte', nav: $nav, translator: $translator}

<div class="card">
    <p n:if="$list->description">{$list->description}</p>
    <p n:if="count($list->getOwners()) > 0">
        <strong>{$translator->trans('list.manage.owners')}:</strong>
        {foreach $list->getOwners() as $owner}
            {$list->resolveMemberDisplayName($owner)}{sep}, {/sep}
        {/foreach}
    </p>
    <p>
        <strong>{$translator->trans('list.info.join_policy')}:</strong>
        {$translator->trans('list.join_policy.' . $list->joinPolicy->value)}
    </p>
</div>
{/block}

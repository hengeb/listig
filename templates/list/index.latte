{layout '../../templates/layout.latte'}

{block title}{$list->displayName} – {$appName ?? 'Listig'}{/block}

{block content}
<div class="card">
    <h1>{$list->displayName}</h1>
    <p class="text-muted"><a n:tag-if="$nav->canPost" href="mailto:{$list->mail}">{$list->mail}</a></p>
    <p n:if="$list->description">{$list->description}</p>
    <p n:if="count($list->getOwners()) > 0">
        <strong>{$translator->trans('list.manage.owners')}:</strong>
        {foreach $list->getOwners() as $owner}
            {$list->resolveMemberDisplayName($owner)}{sep}, {/sep}
        {/foreach}
    </p>
    {include '../list-actions.latte', nav: $nav, translator: $translator}
</div>
{/block}

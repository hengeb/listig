<!DOCTYPE html>
<html lang="{$language}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{block title}{$appName ?? 'Listig'}{/block}</title>
    {* Static assets, served directly by nginx (docker/nginx.conf's /assets/
       location), never routed through Slim — see docs/architecture/web-ui.md "Static assets".
       script.js is loaded here (not at the end of <body>, where it lived as an
       inline block before this file was split up) so that page-specific
       scripts declared inside {block head} (archive-index.js, list-manage.js,
       ...) can rely on its functions (getCsrfToken() etc.) already being
       defined: with `defer`, execution order follows *document* order among
       deferred scripts, regardless of load timing, so this tag must stay
       ahead of every {block head} in source order. *}
    <link rel="stylesheet" href="/assets/style.css">
    <script src="/assets/script.js" defer></script>
    {block head}{/block}
    {*
        Optional operator customization — see docs/architecture/web-ui.md "Custom layout" for the
        full mechanism. /app/config/custom.latte is never baked into the image;
        an operator mounts it as a read-only volume (same convention as
        config.yml/filters.yml) and defines any subset of five named blocks
        with {define blockname}...{/define}. Nothing here fails if the file
        isn't mounted at all, or defines only some of the five.
    *}
    {var $customLayoutFile = $customLayoutFile ?? '/app/config/custom.latte'}
    {if file_exists($customLayoutFile)}
        {import $customLayoutFile}
    {/if}
    {ifset #custom_head}
        {include #custom_head}
    {/ifset}
</head>
<body>
{ifset #custom_body_start}
    {include #custom_body_start}
{/ifset}
{ifset #custom_header}
    {include #custom_header}
{else}
<header>
    <div class="container">
        <a href="/" class="brand"><img src="/assets/logo-mark.svg" alt=""> {$appName ?? 'Listig'}</a>
        <nav>
            {if isset($user)}
                <span class="header-user-email">{$user['email']}</span>
                <a href="#" onclick="listigLogout(event)">{$translator->trans('auth.logout')}</a>
            {/if}
        </nav>
    </div>
</header>
{/ifset}
{ifset #custom_after_header}
    {include #custom_after_header}
{/ifset}
{*
    The page itself. Every page template fills three optional blocks — page_title, page_description,
    page_actions (the list's action buttons) — and `content`. They are captured here so that
    custom.latte can place them anywhere without CSS tricks: {define custom_page_header} replaces
    the heading area, {define custom_main} replaces the whole <main> wrapper and gets the finished
    pieces as parameters. See docs/architecture/web-ui.md "Custom layout".
*}
{capture $pageTitle}{block page_title}{/block}{/capture}
{capture $pageDescription}{block page_description}{/block}{/capture}
{capture $pageActions}{block page_actions}{/block}{/capture}
{capture $pageHeader}
    {ifset #custom_page_header}
        {include #custom_page_header, title: $pageTitle, description: $pageDescription, actions: $pageActions}
    {elseif trim((string) $pageTitle) !== '' || trim((string) $pageActions) !== ''}
        <div class="page-heading">
            <h1 n:if="trim((string) $pageTitle) !== ''">{$pageTitle}</h1>
            <p class="page-description" n:if="trim((string) $pageDescription) !== ''">{$pageDescription}</p>
            {$pageActions}
        </div>
    {/ifset}
{/capture}
{capture $pageContent}<div class="page-content">{block content}{/block}</div>{/capture}
{ifset #custom_main}
    {include #custom_main, pageHeader: $pageHeader, content: $pageContent, title: $pageTitle, description: $pageDescription, actions: $pageActions}
{else}
<main>
    <div class="container">
        {$pageHeader}
        {$pageContent}
    </div>
</main>
{/ifset}
{ifset #custom_attribution}
    {include #custom_attribution}
{else}
<p class="attribution"><a href="https://github.com/hengeb/listig">powered by Listig</a></p>
{/ifset}
{ifset #custom_body_end}
    {include #custom_body_end}
{/ifset}
</body>
</html>

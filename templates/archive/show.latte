{layout '../../templates/layout.latte'}

{block title}{$row['subject']|escapeHtml} – {$list->displayName|escapeHtml} – {$appName}{/block}

{block head}
<style>
    .notice { display: flex; align-items: center; gap: .75rem; background: #fff3cd; color: #856404; border: 1px solid #ffe69c; border-radius: 6px; padding: .6rem .9rem; margin-bottom: .75rem; font-size: .9rem; }
    .notice .notice-icon { font-size: 1.1rem; flex-shrink: 0; }
    .notice .btn { margin-left: auto; flex-shrink: 0; }
    .view-toggle { display: flex; gap: .4rem; margin-bottom: .75rem; }
    .view-toggle .btn { padding: .3rem .7rem; font-size: .8rem; }
    .thumbnail-gallery { display: flex; flex-wrap: wrap; gap: .75rem; }
    .thumbnail-box { display: block; width: 140px; border: 1px solid #eee; border-radius: 6px; padding: .5rem; text-decoration: none; color: #333; text-align: center; }
    .thumbnail-box:hover { border-color: #ccc; background: #fafafa; }
    .thumbnail-box img { max-width: 100%; max-height: 100px; object-fit: contain; display: block; margin: 0 auto .4rem; }
    .thumbnail-box .thumbnail-name { display: block; font-size: .75rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .attachment-list { margin: .5rem 0 0; padding-left: 1.25rem; }
</style>
<script>
function loadImages(btn) {
    const frame = document.getElementById('archive-frame');
    const url = new URL(frame.src, location.origin);
    url.searchParams.set('loadImages', '1');
    frame.src = url.toString();
    btn.closest('.notice').remove();
}

function setView(view) {
    const frame = document.getElementById('archive-frame');
    const url = new URL(frame.src, location.origin);
    url.searchParams.set('view', view);
    frame.src = url.toString();
    document.getElementById('view-html-btn').classList.toggle('btn-primary', view === 'html');
    document.getElementById('view-html-btn').classList.toggle('btn-secondary', view !== 'html');
    document.getElementById('view-text-btn').classList.toggle('btn-primary', view === 'text');
    document.getElementById('view-text-btn').classList.toggle('btn-secondary', view !== 'text');
}
</script>
{/block}

{block content}
<p><a href="/{$list->name}/archive">&larr; {$translator->trans('archive.show.back_to_list')}</a></p>

<div class="card">
    <h1>{($row['subject'] ?? '')|escapeHtml}</h1>
    <table>
        <tr><th>{$translator->trans('list.manage.sender')}</th><td>{($row['sender_name'] ?? $translator->trans('archive.unknown_sender'))|escapeHtml}</td></tr>
        <tr><th>{$translator->trans('list.manage.timestamp')}</th><td data-utc="{str_replace(' ', 'T', $row['mail_date'])}Z">{$row['mail_date']|escapeHtml}</td></tr>
    </table>
</div>

<div class="card" n:if="count($attachments) > 0">
    <h2>{$translator->trans('archive.show.attachments_heading')}</h2>
    {if count($attachments) === 1}
        {foreach $attachments as $index => $attachment}
            <a href="/{$list->name}/archive/{$row['id']}/attachment/{$index}" target="_blank" rel="noopener">{($attachment->name ?? $translator->trans('archive.show.unnamed_attachment'))|escapeHtml}</a>
            <span style="color:#888;font-size:.85em"> ({$attachment->sizeInBytes|formatBytes})</span>
        {/foreach}
    {else}
        <details>
            <summary>{$translator->trans('archive.show.attachments_summary', ['%count%' => count($attachments), '%size%' => $totalAttachmentSize])}</summary>
            <ul class="attachment-list">
                <li n:foreach="$attachments as $index => $attachment">
                    <a href="/{$list->name}/archive/{$row['id']}/attachment/{$index}" target="_blank" rel="noopener">{($attachment->name ?? $translator->trans('archive.show.unnamed_attachment'))|escapeHtml}</a>
                    <span style="color:#888;font-size:.85em"> ({$attachment->sizeInBytes|formatBytes})</span>
                </li>
            </ul>
        </details>
    {/if}
</div>

<div class="card">
    <p n:if="$mailMissing">{$translator->trans('archive.show.mail_unavailable')}</p>

    {* $hasExternalContent/$hasPlainAlternative are already false whenever
       $mailMissing is true (ArchiveController::show() only computes them for a
       resolved mail), so neither needs a separate !$mailMissing check here. *}
    <div class="notice" n:if="$hasExternalContent">
        <span class="notice-icon">&#9888;</span>
        <span>{$translator->trans('archive.show.external_content_notice')}</span>
        <button class="btn btn-secondary" onclick="loadImages(this)">{$translator->trans('archive.show.load_images')}</button>
    </div>
    <div class="view-toggle" n:if="$hasPlainAlternative">
        <button type="button" class="btn btn-primary" id="view-html-btn" onclick="setView('html')">{$translator->trans('archive.show.view_html')}</button>
        <button type="button" class="btn btn-secondary" id="view-text-btn" onclick="setView('text')">{$translator->trans('archive.show.view_text')}</button>
    </div>
    <iframe n:if="!$mailMissing" id="archive-frame" src="/{$list->name}/archive/{$row['id']}/frame" sandbox
        style="width:100%;min-height:400px;border:1px solid #eee;border-radius:6px;background:#fff"
        title="{$translator->trans('archive.show.mail_frame_title')}"></iframe>
</div>

<div class="card" n:if="count($imageAttachments) > 0">
    <h2>{$translator->trans('archive.show.attachment_previews')}</h2>
    <div class="thumbnail-gallery">
        <a n:foreach="$imageAttachments as $index => $attachment" class="thumbnail-box" href="/{$list->name}/archive/{$row['id']}/attachment/{$index}" target="_blank" rel="noopener">
            <img src="/{$list->name}/archive/{$row['id']}/attachment/{$index}" alt="">
            <span class="thumbnail-name">{($attachment->name ?? $translator->trans('archive.show.unnamed_attachment'))|escapeHtml}</span>
        </a>
    </div>
</div>
{/block}

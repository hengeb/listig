{layout '../../templates/layout.latte'}

{block title}{$row['subject']} – {$list->displayName} – {$appName}{/block}

{block head}
<script src="/assets/archive-show.js" defer></script>
{/block}

{block content}
{* Translated strings + IDs for archive-show.js's deleteMail() — a static file
   can't itself contain server-rendered translations, so they're threaded
   through via data attributes instead, same pattern as list-manage.latte's
   #list-manage-i18n. See docs/architecture/i18n.md "Internationalization". *}
<div id="archive-show-i18n" hidden
    data-delete-url="/_/api/archive/{$list->name}/{$row['id']}"
    data-archive-index-url="{$backUrl}"
    data-confirm-delete="{$translator->trans('archive.show.confirm_delete')}"
    data-error-generic="{$translator->trans('list.manage.js_error_generic')}"
></div>
{* Two rows at most: the list's buttons (ListActions — "Archive" is the way back to the
   index), and this mail's own actions inside its card. $nav, $replyHref, $authorHref are only
   passed by ArchiveController — this template is also the moderation / bounce preview
   (ModerationController, BounceController), which have no list navigation and nothing to
   reply to: they get the plain "back" link instead. *}
{ifset $nav}
    {include '../list-actions.latte', nav: $nav, translator: $translator}
{else}
    <p class="archive-show-header"><a href="{$backUrl}">&larr; {$backLabel}</a></p>
{/ifset}

<div class="card">
    <h1>{($row['subject'] ?? '')}</h1>
    <table>
        <tr><th>{$translator->trans('list.manage.sender')}</th><td>{($row['sender_name'] ?? $row['sender_local_part'] ?? $translator->trans('archive.unknown_sender'))}</td></tr>
        <tr><th>{$translator->trans('list.manage.timestamp')}</th><td data-utc="{str_replace(' ', 'T', $row['mail_date'])}Z">{$row['mail_date']}</td></tr>
    </table>
    <div class="message-actions" n:if="($replyHref ?? null) !== null || ($authorHref ?? null) !== null || $allowDelete">
        <a n:if="($replyHref ?? null) !== null" href="{$replyHref}" class="btn btn-primary"
            title="{$translator->trans('archive.show.reply_hint')}">&#8617; {$translator->trans('archive.show.reply')}</a>
        <a n:if="($authorHref ?? null) !== null" href="{$authorHref}" class="btn btn-secondary"
            title="{$translator->trans('archive.show.reply_author_hint')}">{$translator->trans('archive.show.reply_author')}</a>
        <button n:if="$allowDelete" type="button" class="btn btn-danger" onclick="deleteArchivedMail()">{$translator->trans('archive.show.delete')}</button>
    </div>
</div>

<div class="card" n:if="count($attachments) > 0">
    <h2>{$translator->trans('archive.show.attachments_heading')}</h2>
    {if count($attachments) === 1}
        {foreach $attachments as $index => $attachment}
            <a href="{$baseUrl}/attachment/{$index}" target="_blank" rel="noopener">{($attachment->name ?? $translator->trans('archive.show.unnamed_attachment'))}</a>
            <span class="attachment-size"> ({$attachment->sizeInBytes|formatBytes})</span>
        {/foreach}
    {else}
        <details>
            <summary>{$translator->trans('archive.show.attachments_summary', ['%count%' => count($attachments), '%size%' => $totalAttachmentSize])}</summary>
            <ul class="attachment-list">
                <li n:foreach="$attachments as $index => $attachment">
                    <a href="{$baseUrl}/attachment/{$index}" target="_blank" rel="noopener">{($attachment->name ?? $translator->trans('archive.show.unnamed_attachment'))}</a>
                    <span class="attachment-size"> ({$attachment->sizeInBytes|formatBytes})</span>
                </li>
            </ul>
        </details>
    {/if}
</div>

<div class="card">
    <p n:if="$mailMissing">{$translator->trans('archive.show.mail_unavailable')}</p>

    {* $hasExternalContent/$hasPlainAlternative are already false whenever
       $mailMissing is true (ArchiveController::show() only computes them for a
       resolved mail), so neither needs a separate !$mailMissing check here. *}
    <div class="notice" n:if="$hasExternalContent">
        <span class="notice-icon">&#9888;</span>
        <span>{$translator->trans('archive.show.external_content_notice')}</span>
        <button class="btn btn-secondary" onclick="loadImages(this)">{$translator->trans('archive.show.load_images')}</button>
    </div>
    <div class="view-toggle" n:if="$hasPlainAlternative">
        <button type="button" class="btn btn-primary" id="view-html-btn" onclick="setView('html')">{$translator->trans('archive.show.view_html')}</button>
        <button type="button" class="btn btn-secondary" id="view-text-btn" onclick="setView('text')">{$translator->trans('archive.show.view_text')}</button>
    </div>
    <iframe n:if="!$mailMissing" id="archive-frame" class="archive-frame" src="{$baseUrl}/frame" sandbox
        title="{$translator->trans('archive.show.mail_frame_title')}"></iframe>
</div>

<div class="card" n:if="count($imageAttachments) > 0">
    <h2>{$translator->trans('archive.show.attachment_previews')}</h2>
    <div class="thumbnail-gallery">
        <a n:foreach="$imageAttachments as $index => $attachment" class="thumbnail-box" href="{$baseUrl}/attachment/{$index}" target="_blank" rel="noopener">
            <img src="{$baseUrl}/attachment/{$index}" alt="">
            <span class="thumbnail-name">{($attachment->name ?? $translator->trans('archive.show.unnamed_attachment'))}</span>
        </a>
    </div>
</div>
{/block}

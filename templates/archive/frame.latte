<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
    body { font-family: system-ui, sans-serif; margin: 0.75rem; word-wrap: break-word; overflow-wrap: break-word; }
    img { max-width: 100%; height: auto; }
    table { max-width: 100%; }
</style>
</head>
<body>
{if $bodyHtml === null}
    <p>{$translator->trans('archive.show.mail_unavailable')}</p>
{else}
    {* $bodyHtml has already been through ArchiveHtmlSanitizer (HTMLPurifier + cid
       rewriting + external-resource gating) immediately before this render — the
       one deliberate |noescape in this codebase. This document is only ever
       reached inside a sandboxed <iframe> with no allow-scripts (see
       templates/archive/show.latte), so even a sanitizer gap stays inert. *}
    {$bodyHtml|noescape}
{/if}
</body>
</html>

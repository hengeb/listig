{layout '../../templates/layout.latte'}

{block title}{$translator->trans('archive.index.heading')} – {$list->displayName|escapeHtml} – {$appName}{/block}

{block head}
<script src="/assets/archive-index.js" defer></script>
{/block}

{block content}
<h1>{$translator->trans('archive.index.heading')}: {$list->displayName|escapeHtml}</h1>

<div class="archive-toolbar">
    <label for="archive-filter" class="visually-hidden">{$translator->trans('archive.index.filter_label')}</label>
    <input type="text" id="archive-filter" placeholder="{$translator->trans('archive.index.filter_placeholder')}" oninput="filterArchive(this.value)">
</div>

<div class="card" n:if="count($rows) === 0"><p class="empty-state">{$translator->trans('archive.index.no_results')}</p></div>

<table id="archive-table" n:if="count($rows) > 0">
    <thead>
        <tr>
            <th class="thread-col">
                <button type="button" class="thread-toggle-icon" id="thread-toggle" aria-pressed="true"
                    aria-label="{$translator->trans('archive.index.toggle_threading')}"
                    title="{$translator->trans('archive.index.toggle_threading')}"
                    onclick="toggleThreading()">
                    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2.5 1 V12 M2.5 4 H8 M2.5 8 H8 M2.5 12 H8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </th>
            <th>{$translator->trans('list.manage.subject')}</th>
            <th>{$translator->trans('list.manage.sender')}</th>
            <th>{$translator->trans('list.manage.timestamp')}</th>
        </tr>
    </thead>
    <tbody id="archive-tbody">
        <tr
            n:foreach="$rows as $row"
            n:class="!$row['is_thread_start'] ? 'reply-row'"
            data-subject="{mb_strtolower($row['subject'] ?? '')}"
            data-sender="{mb_strtolower($row['sender_name'] ?? '')}"
            data-thread-root="{$row['thread_root']}"
            data-depth="{$row['depth']}"
            data-date="{str_replace(' ', 'T', $row['mail_date'])}Z"
            data-is-thread-start="{$row['is_thread_start'] ? 1 : 0}"
        >
            <td class="thread-col">
                <button n:if="$row['is_thread_start'] && $row['thread_size'] > 1" type="button" class="thread-toggle-icon thread-expand" onclick="toggleThread(this)" aria-expanded="false">
                    <svg class="chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2.5 1 L7.5 5 L2.5 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </td>
            <td class="subject">
                <span class="subject-inner">
                    <span class="thread-indent" style="width:{($row['depth'] * 1.25)|noescape}em"></span>
                    <a href="/{$list->name}/archive/{$row['id']}">{($row['subject'] ?? '')|escapeHtml}</a>
                    <span n:if="$row['has_attachments']" class="paperclip" title="{$translator->trans('archive.index.has_attachments')}">&#128206;</span>
                    <span n:if="$row['is_thread_start'] && $row['thread_size'] > 1" class="reply-count" data-reply-count>
                        {if $row['thread_size'] - 1 === 1}
                            {$translator->trans('archive.index.reply_one', ['%count%' => 1])}
                        {else}
                            {$translator->trans('archive.index.reply_many', ['%count%' => $row['thread_size'] - 1])}
                        {/if}
                    </span>
                </span>
            </td>
            <td>{($row['sender_name'] ?? $translator->trans('archive.unknown_sender'))|escapeHtml}</td>
            <td data-utc="{str_replace(' ', 'T', $row['mail_date'])}Z">{$row['mail_date']|escapeHtml}</td>
        </tr>
    </tbody>
</table>

<p class="pagination" n:if="count($rows) > 0 && $totalPages > 1">
    <a n:if="$page > 1" href="?page={$page - 1}">&laquo; {$translator->trans('archive.index.prev')}</a>
    &nbsp;{$page} / {$totalPages}&nbsp;
    <a n:if="$page < $totalPages" href="?page={$page + 1}">{$translator->trans('archive.index.next')} &raquo;</a>
</p>
{/block}

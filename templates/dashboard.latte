{layout '../templates/layout.latte'}

{block title}{$translator->trans('dashboard.title', ['%app_name%' => $appName])}{/block}

{* One card per list; the buttons come from ListActions (the same set as on every other
   list page), below the text so they wrap instead of overflowing on a narrow screen. *}
{define list-card}
<div class="card">
    {var $nav = $navigations[$list->name]}
    <strong class="list-summary-name"><a href="/{$list->name}">{$list->displayName}</a></strong>
    <span class="list-summary-mail">&lt;<a n:tag-if="$nav->canPost" href="mailto:{$list->mail}">{$list->mail}</a>&gt;</span>
    <p class="list-summary-description" n:if="$list->description">{$list->description}</p>
    {include 'list-actions.latte', nav: $nav, translator: $translator}
</div>
{/define}

{block page_title}{$translator->trans('dashboard.heading')}{/block}

{block content}

<div class="card" n:if="count($lists) === 0">
    <p class="empty-state">{$translator->trans('dashboard.empty')}</p>
</div>
{foreach $lists as $list}
    {include list-card, list: $list, navigations: $navigations, translator: $translator}
{/foreach}

{if count($otherLists) > 0}
<h2>{$translator->trans('dashboard.other_heading')}</h2>
{foreach $otherLists as $list}
    {include list-card, list: $list, navigations: $navigations, translator: $translator}
{/foreach}
{/if}
{/block}

{layout '../templates/layout.latte'}

{block title}{$translator->trans('dashboard.title', ['%app_name%' => $appName])}{/block}

{block page_title}{$translator->trans('dashboard.heading')}{/block}

{* One section (panel) per kind of list: the ones I belong to, the ones I can join, the rest.
   The buttons come from ListActions (the same set as on every other list page), below each
   entry's text so they wrap instead of overflowing on a narrow screen. *}
{define list-entries, array $lists, array $navigations}
    <article class="list-entry" n:foreach="$lists as $list">
        {var $nav = $navigations[$list->name]}
        <strong class="list-summary-name"><a href="/{$list->name}">{$list->displayName}</a></strong>
        <span class="list-summary-mail">&lt;<a n:tag-if="$nav->canPost" href="mailto:{$list->mail}">{$list->mail}</a>&gt;</span>
        <p class="list-summary-description" n:if="$list->description">{$list->description}</p>
        {include 'list-actions.latte', nav: $nav, translator: $translator}
    </article>
{/define}

{block content}
<section class="card dashboard-section" aria-labelledby="dashboard-subscribed">
    <h2 id="dashboard-subscribed">{$translator->trans('dashboard.subscribed_heading')}</h2>
    <p class="empty-state" n:if="count($lists) === 0">{$translator->trans('dashboard.empty')}</p>
    {include list-entries, lists: $lists, navigations: $navigations, translator: $translator}
</section>

<section class="card dashboard-section" n:if="count($joinableLists) > 0" aria-labelledby="dashboard-joinable">
    <h2 id="dashboard-joinable">{$translator->trans('dashboard.joinable_heading')}</h2>
    {include list-entries, lists: $joinableLists, navigations: $navigations, translator: $translator}
</section>

<section class="card dashboard-section" n:if="count($otherLists) > 0" aria-labelledby="dashboard-other">
    <h2 id="dashboard-other">{$translator->trans('dashboard.other_heading')}</h2>
    {include list-entries, lists: $otherLists, navigations: $navigations, translator: $translator}
</section>
{/block}

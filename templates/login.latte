{layout '../templates/layout.latte'}

{block title}{$translator->trans('login.title')}{/block}

{block content}
<div style="max-width:420px;margin:4rem auto">
    <div class="card">
        <h1 style="text-align:center;font-size:1.5rem">{$translator->trans('login.heading')}</h1>

        {if isset($flash) && $flash}
            <div class="flash">{$flash|escapeHtml}</div>
        {/if}

        <form method="post" action="/_/login">
            <label style="display:block;margin-bottom:.5rem;font-weight:600" for="email">{$translator->trans('login.email_label')}</label>
            <input
                type="email"
                id="email"
                name="email"
                required
                autofocus
                style="width:100%;padding:.6rem .75rem;border:1px solid #ccc;border-radius:4px;font-size:1rem;margin-bottom:1rem"
            >
            <button type="submit" class="btn btn-primary" style="width:100%;padding:.65rem">{$translator->trans('login.submit')}</button>
        </form>
    </div>
</div>
{/block}

{layout '../templates/layout.latte'}

{block title}{$translator->trans('login.title', ['%app_name%' => $appName])}{/block}

{block page_title}{$translator->trans('login.heading')}{/block}

{block content}
<div class="narrow-page-sm">
    <div class="card">
        <div class="flash" n:if="isset($flash) && $flash">{$flash}</div>

        {if $oidcEnabled}
            <a href="/_/login/oidc{if $next !== null}?next={$next|rawurlencode}{/if}" class="btn btn-primary btn-block oidc-login-btn">{$translator->trans('auth.oidc_login_button')}</a>
            <div class="login-divider">{$translator->trans('auth.oidc_divider')}</div>
        {/if}

        <form method="post" action="/_/login">
            <input type="hidden" name="next" value="{$next}" n:if="$next !== null">
            <label class="form-label" for="email">{$translator->trans('login.email_label')}</label>
            <input
                type="email"
                id="email"
                name="email"
                required
                autofocus
                class="form-input"
            >
            <button type="submit" class="btn btn-primary btn-block">{$translator->trans('login.submit')}</button>
        </form>
    </div>
</div>
{/block}
